DATABASE_URL="postgresql://app:PAROLA@localhost:5433/app_db?schema=public"
PORT=3000
# Secretul pentru semnarea token-urilor JWT. În dezvoltare poate lipsi (se folosește unul implicit),
# în producție (Docker) e obligatoriu, minim 32 de caractere. Generare:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
