// Schema bazei de date, după diagrama de clase din docs/diagrams/class-diagram.svg
// Diagrama bazei de date: docs/diagrams/db-schema.md

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Sex {
  MALE
  FEMALE
}

enum DogSize {
  SMALL
  MEDIUM
  LARGE
  GIANT
}

enum Temperament {
  FRIENDLY
  PLAYFUL
  SHY
  REACTIVE
}

enum EventType {
  PLAYDATE
  GROUP_WALK
  BREED_MEETUP
}

enum EventStatus {
  ACTIVE
  CANCELLED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum RsvpStatus {
  INVITED
  GOING
  MAYBE
  NOT_GOING
}

enum HealthRecordType {
  VACCINE
  DEWORMING
  VET_VISIT
  WEIGHT
}

enum PlaceType {
  PARK
  DOG_PARK
  CAFE
  VET
  PET_SHOP
}

enum PlaceSource {
  OSM
  USER_EVENTS
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// ───────────────────── 1. Core (căutare) ─────────────────────

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String
  emailVerified   Boolean  @default(false)
  firstName       String
  lastName        String
  avatarUrl       String?
  bio             String?
  // Locație aproximativă: backend-ul rotunjește la 2 zecimale (~1 km) înainte de salvare.
  approxLatitude  Float
  approxLongitude Float
  consentAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dogs                     Dog[]
  blocksMade               Block[]                   @relation("Blocker")
  blocksReceived           Block[]                   @relation("Blocked")
  reportsMade              Report[]                  @relation("Reporter")
  reportsReceived          Report[]                  @relation("ReportedUser")
  posts                    Post[]
  likes                    Like[]
  comments                 Comment[]
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]
  eventsOrganized          Event[]
  eventParticipations      EventParticipant[]
  placeReviews             PlaceReview[]

  @@index([approxLatitude, approxLongitude])
}

model Breed {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  size            DogSize
  careTips        String
  heatSensitive   Boolean  @default(false)
  breathingIssues Boolean  @default(false)
  energyLevel     Int // 1-5, vezi CHECK în migrare
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dogs Dog[]
}

model Dog {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String      @db.Uuid
  breedId     String      @db.Uuid
  name        String
  birthDate   DateTime?
  sex         Sex
  size        DogSize
  temperament Temperament
  neutered    Boolean     @default(false)
  photoUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  breed              Breed              @relation(fields: [breedId], references: [id], onDelete: Restrict)
  posts              Post[]
  eventParticipation EventParticipant[]
  healthRecords      HealthRecord[]

  @@index([ownerId])
  @@index([breedId])
  @@index([size])
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  reportedUserId String?      @db.Uuid
  postId         String?      @db.Uuid
  reason         String
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Cascade peste tot: un SET NULL ar putea lăsa raportul fără țintă (vezi CHECK în migrare).
  reporter     User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  post         Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
}

// ───────────────────── 2. Social ─────────────────────

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @db.Uuid
  dogId     String?  @db.Uuid
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  dog      Dog?      @relation(fields: [dogId], references: [id], onDelete: SetNull)
  likes    Like[]
  comments Comment[]
  reports  Report[]

  @@index([authorId, createdAt])
  @@index([dogId])
}

model Like {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  // SET NULL la ștergerea contului: mesajul rămâne, apare ca „Utilizator șters".
  senderId       String?  @db.Uuid
  content        String
  sentAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, sentAt])
}

// ───────────────────── 3. Întâlniri ─────────────────────

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  // SET NULL la ștergerea contului; backend-ul trece evenimentul pe CANCELLED în aceeași tranzacție.
  organizerId     String?     @db.Uuid
  // Doar evenimentele PUBLIC creează un Place; cele PRIVATE folosesc locationText.
  placeId         String?     @db.Uuid
  locationText    String?
  title           String
  description     String?
  type            EventType
  visibility      Visibility
  status          EventStatus @default(ACTIVE)
  startsAt        DateTime
  endsAt          DateTime
  // Numără câinii, nu oamenii.
  maxParticipants Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organizer    User?              @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  place        Place?             @relation(fields: [placeId], references: [id], onDelete: SetNull)
  participants EventParticipant[]
  placeReviews PlaceReview[]

  @@index([startsAt])
  @@index([placeId])
  @@index([organizerId])
}

model EventParticipant {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @db.Uuid
  userId    String     @db.Uuid
  dogId     String     @db.Uuid
  status    RsvpStatus
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dog   Dog   @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@unique([eventId, dogId])
  @@index([userId])
  @@index([dogId])
}

// ───────────────────── 4. Îngrijire ─────────────────────

model HealthRecord {
  id          String           @id @default(uuid()) @db.Uuid
  dogId       String           @db.Uuid
  type        HealthRecordType
  title       String
  date        DateTime
  nextDueDate DateTime?
  weightKg    Float?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId, date])
  @@index([nextDueDate])
}

// ───────────────────── 5. Hartă (opțional) ─────────────────────

model Place {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  latitude     Float
  longitude    Float
  address      String?
  phone        String?
  website      String?
  openingHours String?
  type         PlaceType
  source       PlaceSource
  // Id-ul din OpenStreetMap, ca importul să nu dubleze locurile.
  osmId        String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  events  Event[]
  reviews PlaceReview[]

  @@index([latitude, longitude])
}

model PlaceReview {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  placeId   String   @db.Uuid
  eventId   String   @db.Uuid
  rating    Int // 1-5, vezi CHECK în migrare
  tags      String[]
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([placeId])
}
